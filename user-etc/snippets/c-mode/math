/* TEMPLATE:
 * Include all standard math/arithmetic libraries: */
#if __STDC__ && (__STDC_VERSION__ < 199901L || __STDC_HOSTED__)
    #include <math.h>                                  /* Mathematics */
#endif
#if (__STDC_VERSION__ == 199901L \\
     || __STDC_VERSION__ >= 201112L && !__STDC_NO_COMPLEX__) \\
    && __STDC_HOSTED__
    #include <complex.h>                                   /* Complex */
    #include <tgmath.h>                          /* Type-generic math */
#endif
#if __STDC_VERSION__ >= 199901L && __STDC_HOSTED__
    #include <fenv.h>                   /* Floating-point environment */
#endif
#if __STDC_VERSION__ >= 202311L && __STDC_HOSTED__
    #include <stdckdint.h>              /* Checked Integer Arithmetic */
#endif
/* Two notes:
 *
 * 1. I have NO idea why the standard title-cases the heading for \$7.20
 *    "Checked Integer Arithmetic <stdckdint.h>", and _only_ that
 *    heading.
 *
 * 2. <tgmath.h> already includes <complex.h> and <math.h>, and the
 *    circumstances where we include <tgmath.h> are the same as
 *    <complex.h>, so it's wholly redundant to include them both,
 *    however this is a template I use in files meant for your eyes,
 *    dear reader, not just my own, and I want to be explicit for anyone
 *    unfamiliar with the annals of the C standard library.
 *
 * The following predefined macros may be of note:
 *
 * Since C11 (__STDC_VERSION__ == 201112L):
 *
 * - __STDC_NO_COMPLEX__
 *
 *   Conditionally defined to be exactly 1 if complex types and
 *   <complex.h> are unavailable. */$0